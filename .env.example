# ==========================================
# AlloyCal Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Neon PostgreSQL via Drizzle ORM)
# Use the pooled connection string (-pooler) for serverless execution
DATABASE_URL="postgresql://user:password@ep-sample-project-pooler.us-east-2.aws.neon.tech/alloycal?sslmode=require"

# Direct Database URL for migrations (unpooled)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/alloycal?sslmode=require"
